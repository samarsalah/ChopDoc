{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ]
  },
  "ConnectionStrings": {
    "ChopDoc": "Data Source=App_Data/chopdoc.db"
  },
  "Storage": {
    "RootPath": "App_Data/storage"
  },
  "DocumentProcessing": {
    "DefaultSizeLimitMb": 2
  }
}
